    {
      "type": "deb",
      "namespace": "debian",
      "name": "libdav1d7",
      "version": "1.5.1-1",
      "purl": "pkg:deb/debian/libdav1d7@1.5.1-1?arch=amd64&os_distro=trixie&os_name=debian&os_version=13&upstream=dav1d",
      "author": "Debian Multimedia Maintainers <debian-multimedia@lists.debian.org>",
      "description": "fast and small AV1 video stream decoder (shared library)\n dav1d is an AOMedia Video 1 (AV1) cross-platform decoder and focused on speed\n and correctness.\n .\n dav1d supports the following features:\n * support for all features of the AV1 bitstream\n * support for all bitdepth, 8, 10 and 12bits\n * support for all chroma subsamplings 4:2:0, 4:2:2, 4:4:4 and grayscale\n * full acceleration for AVX-2 chips\n * full acceleration for SSSE3+ chips\n * full acceleration for ARMv8 chips\n * partial acceleration for ARMv7 chips\n .\n This package provides the shared library.",
      "licenses": [
        "BSD-2-Clause",
        "ISC"
      ],
      "installed_size": 1730,
      "locations": [
        {
