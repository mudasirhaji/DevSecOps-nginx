    {
      "type": "deb",
      "namespace": "debian",
      "name": "libheif-plugin-dav1d",
      "version": "1.23.6-2~deb13u1",
      "purl": "pkg:deb/debian/libheif-plugin-dav1d@1.23.6-2~deb13u1?arch=amd64&os_distro=trixie&os_name=debian&os_version=13&upstream=libheif",
      "author": "Debian Multimedia Maintainers <debian-multimedia@lists.debian.org>",
      "description": "HEIF and AVIF file format decoder and encoder - dav1d plugin\n libheif is an ISO/IEC 23008-12:2017 HEIF and AVIF (AV1 Image File Format) file\n format decoder and encoder. There is partial support for ISO/IEC 23008-12:2022\n (2nd Edition) capabilities.\n .\n HEIF and AVIF are new image file formats employing HEVC (H.265) or AV1 image\n coding, respectively, for the best compression ratios currently possible.\n .\n libheif supports various codecs provided by plugins for image decoding and\n encoding.\n .\n This package contains the dav1d plugin that uses dav1d to decode AV1 images.\n .\n dav1d: https://www.videolan.org/projects/dav1d.html",
      "licenses": [
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSD-4-Clause-UC",
        "BSL-1.0",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "LGPL-3.0-only",
        "LGPL-3.0-or-later"
      ],
