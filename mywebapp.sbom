    {
      "type": "deb",
      "namespace": "debian",
      "name": "libpam0g",
      "version": "1.7.0-5",
      "purl": "pkg:deb/debian/libpam0g@1.7.0-5?arch=amd64&os_distro=trixie&os_name=debian&os_version=13&upstream=pam",
      "author": "Sam Hartman <hartmans@debian.org>",
      "description": "Pluggable Authentication Modules library\n Contains the shared library for Linux-PAM, a library that enables the\n local system administrator to choose how applications authenticate users.\n In other words, without rewriting or recompiling a PAM-aware application,\n it is possible to switch between the authentication mechanism(s) it uses.\n One may entirely upgrade the local authentication system without touching\n the applications themselves.",
      "licenses": [
        "BSD-3-Clause",
        "Beerware",
        "GPL-1.0-only",
        "GPL-2.0-only",
        "GPL-2.0-or-later",
