    {
      "type": "deb",
      "namespace": "debian",
      "name": "libgnutls30t64",
      "version": "3.8.9-3+deb13u4",
      "purl": "pkg:deb/debian/libgnutls30t64@3.8.9-3%2Bdeb13u4?arch=amd64&os_distro=trixie&os_name=debian&os_version=13&upstream=gnutls28",
      "author": "Debian GnuTLS Maintainers <pkg-gnutls-maint@lists.alioth.debian.org>",
      "description": "GNU TLS library - main runtime library\n GnuTLS is a portable library which implements the Transport Layer\n Security (TLS 1.0, 1.1, 1.2, 1.3) and Datagram\n Transport Layer Security (DTLS 1.0, 1.2) protocols.\n .\n GnuTLS features support for:\n - certificate path validation, as well as DANE and trust on first use.\n - the Online Certificate Status Protocol (OCSP).\n - public key methods, including RSA and Elliptic curves, as well as password\n and key authentication methods such as SRP and PSK protocols.\n - all the strong encryption algorithms, including AES and Camellia.\n - CPU-assisted cryptography with VIA padlock and AES-NI instruction sets.\n - HSMs and cryptographic tokens, via PKCS #11.\n .\n This package contains the main runtime library.",
      "installed_size": 3504,
      "locations": [
        {
          "path": "/usr/share/doc/libgnutls30t64/copyright",
