    {
      "type": "deb",
      "namespace": "debian",
      "name": "libmaxminddb",
      "version": "1.12.2-1",
      "purl": "pkg:deb/debian/libmaxminddb@1.12.2-1?os_distro=trixie&os_name=debian&os_version=13",
      "author": "Faidon Liambotis <paravoid@debian.org>",
      "description": "IP geolocation database library\n The libmaxminddb library provides a C library for reading MaxMind DB files,\n including the GeoIP2 databases from MaxMind. This is a custom binary format\n designed to facilitate fast lookups of IP addresses while allowing for great\n flexibility in the type of data associated with an address.\n .\n The MaxMind DB format is an open format. The spec is available at\n https://maxmind.github.io/MaxMind-DB/. This spec is licensed under the Creative\n Commons Attribution-ShareAlike 3.0 Unported License.",
      "licenses": [
        "Apache-2.0",
        "BSD-2-Clause",
        "LGPL-3.0-only",
        "LGPL-3.0-or-later"
      ],
