    {
      "type": "deb",
      "namespace": "debian",
      "name": "libbrotli1",
      "version": "1.1.0-2+deb13u1",
      "purl": "pkg:deb/debian/libbrotli1@1.1.0-2%2Bdeb13u1?arch=amd64&os_distro=trixie&os_name=debian&os_version=13&upstream=brotli",
      "author": "Tomasz Buchert <tomasz@debian.org>",
      "description": "library implementing brotli encoder and decoder (shared libraries)\n Brotli is a generic-purpose lossless compression algorithm\n that compresses data using a combination of a modern variant\n of the LZ77 algorithm, Huffman coding and 2nd order context modeling,\n with a compression ratio comparable to the best currently available\n general-purpose compression methods. It is similar in speed with\n deflate but offers more dense compression.\n .\n This package installs shared libraries.",
      "licenses": [
        "MIT"
      ],
